---
import type { CollectionEntry } from "astro:content";
import { Kaleidoscope } from "./Kaleidoscope";

type Props = {
  hero: CollectionEntry<"homepage">["data"]["hero"];
};

const { hero } = Astro.props;
const tagline = hero.tagline || "See Infinitely.";
const [firstWord = "See", ...restWords] = tagline.split(" ");
const accentWords = restWords.join(" ") || "Infinitely.";
---

<section class="home-hero" id="hero" aria-labelledby="hero-heading">
  <div class="home-hero__image" aria-hidden="true"></div>
  <div class="home-hero__shade" aria-hidden="true">
    <Kaleidoscope client:load />
  </div>

  <div class="home-hero__content">
    <h1 id="hero-heading" class="home-hero__title" data-aos="fade-up-sm">
      <span>{firstWord}</span>{" "}
      <em>{accentWords}</em>
    </h1>
    <p class="home-hero__subtitle" data-aos="fade-up-sm" data-aos-delay="100">
      {hero.subtitle}
    </p>
    <div class="flex gap-2 mt-8 justify-center" data-aos="fade-up-sm">
      <a href="#connect" class="btn-sm w-40 glass bg-text-light text-background"
        >Connect</a
      >
    </div>
  </div>

  <a
    class="home-hero__scroll"
    href="#about"
    aria-label="Scroll to about"
    data-aos="fade-up-sm"
  >
    <span class="material-symbols-outlined"> arrow_downward </span>
  </a>
</section>

<style>
  @reference "@/styles/main.css";

  .home-hero {
    @apply relative isolate h-dvh flex flex-col justify-center gap-2 overflow-hidden bg-primary text-text-light px-6;
  }

  .home-hero__image,
  .home-hero__shade {
    @apply absolute inset-0 -z-20;
  }

  .home-hero__image {
    @apply bg-black;
    /* background-image: url("/gradient-4.jpg"); */
  }

  .home-hero__content {
    @apply mx-auto text-center mt-12;
  }

  .home-hero__title {
    @apply m-0 text-7xl lg:text-8xl font-secondary font-light tracking-tighter font-features-["liga"_on] text-text-light text-balance leading-tight;
  }

  .home-hero__title span {
    @apply tracking-tighter;
  }

  .home-hero__title em {
    @apply font-tertiary font-normal italic;
  }

  .home-hero__subtitle {
    @apply mx-auto mt-2 max-w-200 font-primary text-base font-normal tracking-tight text-text-light/85 text-balance;
  }

  .home-hero__scroll {
    @apply rounded-lg flex glass-sharp w-40 justify-center mx-auto p-2 px-3 items-center h-9 no-underline *:text-sm;
  }
</style>
