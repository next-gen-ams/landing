---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  team: CollectionEntry<"homepage">["data"]["team"];
};

const { team } = Astro.props;
---

<section class="border-text-light/20 border-t section bg-black" id="team">
  <div class="container">
    <div class="flex max-w-5xl mx-auto mb-16">
      <p
        class="text-3xl tracking-tighter leading-tight font-secondary [&>strong]:font-tertiary [&>strong]:tracking-normal [&>strong]:italic [&>strong]:block [&>strong]:font-normal md:text-4xl lg:text-5xl text-text-light/90 mb-10 text-balance"
        set:html={markdownify(team.headline)}
        data-aos="fade-up-sm"
      />
    </div>

    <div class="grid grid-cols-1 gap-12 mx-auto max-w-5xl!">
      {
        team.members.map((member: any, index: number) => (
          <div
            class="group transition-all duration-500 flex border-b border-text-light/50 pb-10 flex-col lg:flex-row gap-6 *:flex-1"
            data-aos="fade-up-sm"
            data-aos-delay={50 + index * 100}
          >
            <div class="flex flex-col gap-6 justify-between">
              <img
                src={member.image}
                alt={member.name}
                class="aspect-square h-32 rounded-lg w-32"
              />
              <div class="flex gap-2 flex-col z-1">
                <div class="text-base tracking-tighter">
                  <h4
                    set:html={markdownify(member.name)}
                    class="text-3xl md:text-3xl lg:text-4xl font-primary text-text-light tracking-tighter"
                  />
                  <p class="text-base text-text-light mt-1">
                    {member.role} / {member.epithet}
                  </p>
                </div>
              </div>
            </div>
            <p
              set:html={markdownify(member.bio)}
              class="text-text-light text-sm leading-relaxed font-primary flex-1 text-justify"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
