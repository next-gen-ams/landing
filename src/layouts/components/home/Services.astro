---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { ServicesCarousel } from "./ServicesCarousel";

type Props = {
  services: CollectionEntry<"homepage">["data"]["services"];
};

const { services } = Astro.props;
---

<section
  class="section bg-[linear-gradient(to_bottom,#000000_10%,#00000066_10%,#000000aa),url('/chip.webp')] bg-cover bg-top"
  id="services"
>
  <div class="container">
    <div class="overflow-hidden lg:overflow-visible">
      <ServicesCarousel client:load />
      <div class="text-center text-light mt-6 text-sm">
        AMS by Kaleidoscope MT
      </div>
    </div>
    <div class="flex mt-12 w-full max-w-5xl mx-auto">
      <h2
        set:html={markdownify(services.headline)}
        class="text-3xl tracking-tighter text-center mx-auto z-1 font-secondary [&>strong]:font-tertiary [&>strong]:tracking-normal [&>strong]:italic [&>strong]:font-normal md:text-3xl lg:text-4xl text-text-light/90 leading-snug text-balance"
        data-aos="fade-up-sm"
      />
    </div>
    <div class="max-w-5xl flex flex-col gap-2 items-start mx-auto">
      <div class="flex mt-12 gap-2 flex-col">
        {
          services.items.map((item: any, index: number) => (
            <div
              class:list={[
                "flex-1 flex lg:flex-row flex-col p-6 gap-6 backdrop-blur-lg bg-black/30 z-1 rounded-lg",
              ]}
              data-aos="fade-up-sm"
              data-aos-delay={index * 100}
            >
              <div class="flex flex-col flex-1 justify-between">
                <div class="p-2 bg-primary flex justify-center glass items-center size-10 rounded-lg mb-4">
                  <img
                    src="/logo-small.svg"
                    class="brightness-500 contrast-200 saturate-0"
                  />
                </div>
                <h3
                  set:html={markdownify(item.title)}
                  class="text-xl lg:text-2xl font-secondary text-text-light tracking-tight"
                />
              </div>
              <p
                set:html={markdownify(item.description)}
                class="leading-relaxed text-sm text-text-light flex-1"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
