---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { ServicesCarousel } from "./ServicesCarousel";

type Props = {
  services: CollectionEntry<"homepage">["data"]["services"];
};

const { services } = Astro.props;
---

<section
  class="section bg-[linear-gradient(to_bottom,#000000_10%,black,black)] bg-cover bg-top"
  id="services"
>
  <div class="bg-primary py-12 pb-24">
    <div class="container">
      <div class="flex mt-12 w-full max-w-5xl mx-auto pb-12">
        <h2
          set:html={markdownify(services.headline)}
          class="text-3xl leading-tight tracking-tighter z-1 font-secondary [&>strong]:font-tertiary [&>strong]:tracking-normal [&>strong]:italic [&>strong]:font-normal md:text-4xl lg:text-5xl text-text-light/90 text-balance"
          data-aos="fade-up-sm"
        />
      </div>
      <div class="overflow-hidden lg:overflow-visible">
        <ServicesCarousel client:load />
        <div class="text-right text-light/80 mt-6 max-w-5xl mx-auto text-sm">
          AMS by Kaleidoscope MT
        </div>
      </div>
    </div>
  </div>
  <div class="container pt-12">
    <div class="max-w-5xl flex flex-col gap-2 items-start mx-auto">
      <div class="flex mt-12 gap-2 flex-col">
        {
          services.items.map((item: any, index: number) => (
            <div
              class:list={[
                "flex-1 flex lg:flex-row flex-col py-6 gap-6 lg:gap-12 border-b border-text-light/20",
              ]}
              data-aos="fade-up-sm"
              data-aos-delay={index * 100}
            >
              <div class="flex flex-col flex-1 justify-between">
                <h3
                  set:html={markdownify(item.title)}
                  class="text-2xl lg:text-3xl font-secondary text-text-light tracking-tighter"
                />
              </div>
              <p
                set:html={markdownify(item.description)}
                class="leading-relaxed text-sm text-text-light flex-3"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
