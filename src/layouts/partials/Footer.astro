---
import config from "@/config/config.json";
import { markdownify } from "@/lib/utils/textConverter";

type Props = {
  email: string;
};

const { copyright } = config.params;
const { email } = Astro.props;
---

<footer class="bg-primary py-6 w-full">
  <div class="px-6">
    <div class="flex flex-col md:flex-row items-center gap-4">
      <div class="flex-1">
        <a href="/" class="flex items-center gap-2">
          <img src="logo-white.svg" class="h-4" />
        </a>
      </div>
      <a
        href={`mailto:${email}`}
        class="text-sm text-text-light hover:text-secondary transition"
      >
        {email}
      </a>
      <p class="text-sm text-text-light/80" set:html={markdownify(copyright)} />
    </div>
  </div>
</footer>
